# Copy to .env (docker compose reads it automatically) and set your hostname.
#
#   cp .env.example .env && nano .env
#
# The hostname must already resolve to this machine — Caddy cannot issue a
# certificate for a domain that points elsewhere.
DOMAIN=flare.example.com

# No hostname yet, reaching the box by IP? Use HTTP on port 80 instead:
# DOMAIN=:80
